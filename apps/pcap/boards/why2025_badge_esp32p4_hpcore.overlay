/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * The WHY2025 badge's ESP32-P4: USB-C port J8 on its OTG HS controller (GPIO2 low, the board's
 * default) with the shell on CDC-ACM, DFU and the pcapng stream; boot messages and logs on the
 * CH340 (UART0); the C6 on sdhc1 (apps/osmosdr_serial, gapless by default on this board).
 */

/ {
	chosen {
		esdr,link-sdio = &sdhc1;
		zephyr,shell-uart = &cdc_acm_uart0;
	};

	/* GPIO2 hands USB-C port J8 to the ESP32-C6; GPIO12 is its enable. */
	zephyr,user {
		usb-mux-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		c6-enable-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
	};
};

/* The ESP32-C6 runs the radio firmware, not esp-hosted, whose driver would reset it. */
&esp_hosted_mcu {
	status = "disabled";
};

zephyr_udc0: &usb_otg {
	status = "okay";
	/*
	 * An IN endpoint is bulk capable only with a FIFO of a whole high-speed packet (512 bytes,
	 * 128 words). The endpoints take the FIFOs in order: CDC-ACM's notification endpoint the
	 * first (16 words, its packets are short), its data endpoint the second, the pcapng stream
	 * the third. With the RX FIFO (256) and EP0's (32) that is 816 of the controller's 896
	 * words (GHWCFG3), where three FIFOs of 128 would not fit.
	 */
	g-tx-fifo-size = <16 128 128 64 64 64 64>;

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "ESP-SDR pcap shell";
	};
};

#include "../../micropython/boards/partitions_p4.dtsi"
