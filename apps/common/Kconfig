# USB start, DFU and the trial watchdog (common/src/app_usb.c).

# zephyr.signed.confirmed.bin: the image padded to its slot, ending in a confirmed trailer, for
# esptool (west dfu --esptool). Written plain, the slot keeps whatever trailer an earlier image
# left, which MCUboot then reads as bad magic: the image boots, but cannot be confirmed.
config MCUBOOT_GENERATE_CONFIRMED_IMAGE
	default y if BOOTLOADER_MCUBOOT

config APP_USB_START_DELAY_MS
	int "Delay before USB OTG takes the PHY from USB-Serial-JTAG"
	default 0
	help
	  Until then the board stays on USB-Serial-JTAG, so esptool can still
	  reset it into the ROM bootloader with RTS/DTR. Updates normally go
	  over DFU; a few seconds here give a recovery path for images that
	  break USB outside of a DFU trial boot.

config APP_USB_DFU
	bool "USB DFU into the MCUboot secondary slot"
	default y
	depends on BOOTLOADER_MCUBOOT && USB_DEVICE_STACK_NEXT
	select USBD_DFU
	select FLASH
	select FLASH_MAP
	select STREAM_FLASH
	select IMG_MANAGER
	select IMG_ERASE_PROGRESSIVELY
	select REBOOT

if APP_USB_DFU

config USBD_DFU_FLASH
	default y

config USBD_DFU_FLASH_SLOT0
	default n

config USBD_DFU_FLASH_SLOT1
	default y

config APP_USB_DFU_VID
	hex "USB vendor ID in DFU mode"
	default 0x2fe3
	help
	  Independent of the application's own vendor ID (SAMPLE_USBD_VID), which an application may
	  change to match a host driver; DFU mode keeps this one so west dfu finds it.

config APP_USB_DFU_PID
	hex "USB product ID in DFU mode"
	default 0xffff

config APP_TRIAL_WATCHDOG
	bool "Revert a DFU image the host does not confirm"
	default y
	select WATCHDOG
	select MCUBOOT_SHELL
	help
	  On a test boot after DFU, arm the hardware watchdog until the image
	  is confirmed, normally with "mcuboot confirm" on the USB shell. A
	  hang or a missing confirmation resets the chip; MCUboot reverts.

config APP_TRIAL_TIMEOUT_S
	int "Seconds the host has to confirm a DFU image"
	default 60
	depends on APP_TRIAL_WATCHDOG
	help
	  Passed to the watchdog as its timeout. The ESP32 driver currently
	  counts milliseconds as 0.5 ms ticks, so the reset comes after about
	  half of this.

endif # APP_USB_DFU

config APP_LIVENESS_WATCHDOG
	bool "Reset when the system hangs"
	select WATCHDOG
	help
	  Keeps the hardware watchdog armed, fed every 500 ms from the system
	  work queue: a wedged system resets instead of needing a replug. An
	  unconfirmed DFU image is fed for about half of
	  APP_TRIAL_TIMEOUT_S (the driver's tick scale), then reverts as before.

config APP_LIVENESS_TIMEOUT_MS
	int "Liveness watchdog timeout in ms"
	default 4000
	depends on APP_LIVENESS_WATCHDOG
	help
	  The ESP32 driver counts milliseconds as 0.5 ms ticks: 4000 resets
	  after about 2 s without feeding.

config APP_USB_MSG_HOOK
	bool "Pass the USB device's messages to app_usb_msg()"
	help
	  For code that uses the application's USB device without owning it:
	  multiapp's extensions, which bring their USB up themselves standalone.

config APP_PROF_SHELL
	bool "Shell command prof (esp_sdr_prof.h)"
	default y
	depends on SHELL && ESP_SDR_CPU_PROF
	select THREAD_MONITOR
	help
	  "prof start [period_us] | stop | dump": the ring's profile of the
	  other CPU (CONFIG_ESP_SDR_CPU_PROF). The dump prints the samples in
	  the layout of Zephyr's "perf printbuf", each under its thread's
	  entry function (THREAD_MONITOR), with a table of the threads before
	  them: scripts/place/prof_map.py, scripts/place/hot_text.py and
	  Zephyr's scripts/profiling/stackcollapse.py read it.

# A dump of 131072 samples is 7 MB: over CDC-ACM it took 46 s through the shell's default 8 byte
# transmit buffer, 11 s through 1 KB.
configdefault SHELL_BACKEND_SERIAL_TX_RING_BUFFER_SIZE
	default 1024 if APP_PROF_SHELL

# perf (subsys/profiling/perf) prints the end of a recording from the system work queue, and a
# CDC-ACM shell transmits on the CDC-ACM work queue, by default the system work queue as well: the
# print then waits for itself until the liveness watchdog resets the board.
configdefault USBD_CDC_ACM_WORKQUEUE
	default y if PROFILING_PERF
