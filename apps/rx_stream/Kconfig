mainmenu "ESP-SDR RX stream"

config APP_SDR
	bool "Capture and stream samples"
	default y
	help
	  Disable to bring up USB and the network alone: the app then sends
	  one small test datagram per second.

config APP_FREQ_MHZ
	int "Receive frequency in MHz"
	range 100 6000
	default 2412

config APP_RATE
	int "Capture rate index"
	range 0 6
	default 6
	help
	  0: 80 MS/s, 1: 40 MS/s, 6: 16 MS/s.

config APP_BURST_SAMPLES
	int "Complex samples per burst"
	range 256 16380
	default 1404
	help
	  Raw bursts at the capture rate, and the most a decimated burst may
	  hold. 1404 fills whole signal data packets at every item size: 3 at
	  12 bit (468 each), 2 at 8 bit (704), 4 at 16 bit (352). USB moves a
	  limited number of datagrams per second, so a part-filled packet costs
	  as much as a full one.

config APP_BURSTS
	int "Burst buffers between the capture and process cores"
	default 3
	help
	  Each holds APP_BURST_SAMPLES * 4 bytes. USB full speed limits the
	  stream to about 90 bursts/s, so a few are enough.

config APP_NET_CPU
	int "CPU for the network and USB threads (-1: not pinned)"
	range -1 1
	default 0
	help
	  Pins the cooperative and high priority system threads (net TX/RX
	  queues, net_mgmt, usbd, UDC, system work queue, Wi-Fi events) to
	  this CPU, the capture CPU, so they never delay the process thread or
	  the DAC leader on the other one.

config APP_BURST_INTERVAL_MS
	int "Pause between bursts in ms (0: back to back)"
	default 0

config APP_VRT_STREAM_ID
	hex "VITA 49 stream identifier"
	default 0x5d5d0001

config APP_VRT_SAMPLES_PER_PACKET
	int "Complex samples per IF data packet"
	range 1 1000
	default 352
	help
	  352 samples plus six header and trailer words fit a 1500 byte
	  IPv6 UDP datagram.

config APP_UDP_PEER
	string "IPv6 destination of the VRT stream"
	default "ff02::1"
	help
	  The default link-local all-nodes group reaches the host without
	  any address setup on either side.

config APP_UDP_PORT
	int "UDP destination port of the VRT stream"
	default 4991

config APP_TX
	bool "Receive VITA 49.2 transmit packets from the host"
	default y
	select ESP_SDR_TX
	help
	  Signal data and command packets on UDP; samples go to the
	  esp_sdr_tx backend (a stub unless the application registers one).

config APP_TX_PORT
	int "UDP port for transmit packets"
	default 4992
	depends on APP_TX

config APP_TX_RATE
	int "Transmit sample rate until a command sets one"
	default 100000
	depends on APP_TX

config APP_USB_START_DELAY_MS
	int "Delay before USB OTG takes the PHY from USB-Serial-JTAG"
	default 0
	help
	  Until then the board stays on USB-Serial-JTAG, so esptool can still
	  reset it into the ROM bootloader with RTS/DTR. Updates normally go
	  over DFU; a few seconds here give a recovery path for images that
	  break USB outside of a DFU trial boot.

config APP_USB_DFU
	bool "USB DFU into the MCUboot secondary slot"
	default y
	depends on BOOTLOADER_MCUBOOT
	select USBD_DFU
	select FLASH
	select FLASH_MAP
	select STREAM_FLASH
	select IMG_MANAGER
	select IMG_ERASE_PROGRESSIVELY
	select REBOOT

if APP_USB_DFU

config USBD_DFU_FLASH
	default y

config USBD_DFU_FLASH_SLOT0
	default n

config USBD_DFU_FLASH_SLOT1
	default y

config APP_USB_DFU_PID
	hex "USB product ID in DFU mode"
	default 0xffff

config APP_TRIAL_WATCHDOG
	bool "Revert a DFU image the host does not confirm"
	default y
	select WATCHDOG
	select MCUBOOT_SHELL
	help
	  On a test boot after DFU, arm the hardware watchdog until the image
	  is confirmed, normally with "mcuboot confirm" on the USB shell. A
	  hang or a missing confirmation resets the chip; MCUboot reverts.

config APP_TRIAL_TIMEOUT_S
	int "Seconds the host has to confirm a DFU image"
	default 60
	depends on APP_TRIAL_WATCHDOG
	help
	  Passed to the watchdog as its timeout. The ESP32 driver currently
	  counts milliseconds as 0.5 ms ticks, so the reset comes after about
	  half of this.

endif # APP_USB_DFU

# USB device helpers shared with the in-tree USB samples.
source "samples/subsys/usb/common/Kconfig.sample_usbd"

source "Kconfig.zephyr"
