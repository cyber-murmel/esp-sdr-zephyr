#define APP_SHELL_LABEL "ESP-SDR shell"
#include "../../common/boards/s3_cdc_shell.dtsi"

/ {
	/* USB network function; the host side of the link gets MAC 00:00:5e:00:53:01. */
	cdc_ncm_eth0: cdc_ncm_eth0 {
		compatible = "zephyr,cdc-ncm-ethernet";
		remote-mac-address = "00005E005301";
	};
};
