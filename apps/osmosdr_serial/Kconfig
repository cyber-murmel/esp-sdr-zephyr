mainmenu "ESP-SDR osmosdr over a serial link"

config APP_FREQ_MHZ
	int "Centre frequency in MHz at boot"
	range 100 6000
	default 2437

config APP_RX_DIAG
	bool "Receive through the modem diagnostic bus (ESP32-C5)"
	depends on SOC_SERIES_ESP32C5
	select ESP_SDR_DIAG
	help
	  Gapless 40 MS/s ring through the GPIO matrix and PARLIO (esp_sdr_diag.h), a boxcar
	  of 16 and a CIC in the library down to the requested rate, instead of the IQ
	  estimator polled by the CPU. Drives 8 pads as outputs while receiving; the nibble
	  window is picked from the signal level when a stream starts.

config APP_LINK_SDIO
	bool "The link is the SDIO slave (ESP32-C6)"
	depends on SOC_SERIES_ESP32C6
	help
	  The host (the WHY2025 badge's ESP32-P4) reaches the radio over SDIO function 1, 4-bit
	  (src/link_sdio.c), instead of a UART or USB-Serial-JTAG. It carries receive rates up
	  to 2 MS/s, 8-bit items above 250 kS/s.

# Where the Wi-Fi driver brings the radio up (prj.conf): no power save, and no IP traffic, the
# network stack only carries the driver, minimal. Defaults rather than prj.conf lines, which
# would warn in an image without them (the gapless one).
choice ESP32_WIFI_STA_POWER_SAVE_MODE
	default ESP32_WIFI_STA_POWER_SAVE_NONE
endchoice

configdefault NET_IPV6
	default n

configdefault NET_IPV4
	default y

configdefault NET_PKT_RX_COUNT
	default 4

configdefault NET_PKT_TX_COUNT
	default 4

configdefault NET_BUF_RX_COUNT
	default 8

configdefault NET_BUF_TX_COUNT
	default 8

configdefault NET_RX_STACK_SIZE
	default 1024

# Block 3 holds the staging ring and the stream's blocks (40 KiB with the bounce buffers).
configdefault ESP_SDR_GAPLESS_STAGE_KB
	default 64

source "Kconfig.zephyr"
