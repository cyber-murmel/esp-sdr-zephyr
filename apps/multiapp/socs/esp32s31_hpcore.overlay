/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * multiapp on the ESP32-S31: the apps as files on the FAT volume. The board's overlay puts the
 * shell on a CDC-ACM port of its USB connector.
 */

/ {
	chosen {
		/* The crystal calibration (esp_sdr/cal): settings on ZMS in a partition of its own. */
		zephyr,settings-partition = &cal_partition;
	};

	/* The apps as files: the FAT volume, block device "FLASH". */
	fat_disk: fat_disk {
		compatible = "zephyr,flash-disk";
		partition = <&fat_partition>;
		disk-name = "FLASH";
		cache-size = <4096>;
	};

	fstab {
		compatible = "zephyr,fstab";

		flash_fs: flash_fs {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/FLASH:";
			disk-access;
		};
	};
};

/* The die temperature for osmosdr_hs's crystal calibration (apps/common/dietemp.overlay). */
&coretemp {
	status = "okay";
};

#include "../boards/partitions_s31.dtsi"
