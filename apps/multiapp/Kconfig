mainmenu "multiapp: one firmware that runs the others"

config MULTIAPP_INSTR_HEAP_KB
	int "Extension code heap in PSRAM, KiB"
	default 1344

config MULTIAPP_DATA_HEAP_KB
	int "Extension data heap in PSRAM, KiB"
	default 1024
	help
	  The extensions' data, read-only data and bss, and llext's metadata.

config MULTIAPP_MODULE_HEAP_SIZE
	int "Internal RAM for the modules that run from it, bytes"
	default 8192 if SOC_SERIES_ESP32S31
	default 35840
	help
	  IRAM_ATTR code, data and bss of the modules built INTERNAL: below ring
	  bank 0 (src/apps.c), where a size that does not fit fails the host's
	  link. The Wi-Fi boots need the most: wifi and phy, about 33.4 KB. coex
	  also loads sdr (43 KB in all), which goes into dump bank 2 (BANK2,
	  doc/apps/multiapp-internals.md).

config MULTIAPP_MODULE_HIGH_HEAP_SIZE
	int "Bytes of the high region for a module's bss"
	# The ESP32-S31 has no high region: a token heap.
	default 256 if SOC_SERIES_ESP32S31
	default 14528
	help
	  The rest of the high region next to the area, for the bss of a module
	  built INTERNAL HIGH_BSS. A size that does not fit fails the host's link.

config MULTIAPP_MODULE_TESTS
	bool "The module loader's test modules"
	help
	  hello also needs hellolib in PSRAM, which needs hellofast in internal
	  RAM: the commands "hello mod" and "hello phy".

config MULTIAPP_STACK_SIZE
	int "Largest stack of an app's main() thread"
	default 4096
	help
	  One stack in PSRAM for every app's main(); an app that asks for more
	  (multiapp_extension() STACK) is refused.

# A default, not an assignment: the wifi module's Kconfig pass turns on what this depends on being off.
config ESP_SDR_PHY_ONLY
	default y

config MULTIAPP_SIGNED_EXTENSIONS
	bool "The sysbuild signs with the project's own key (SB_CONFIG_ESDR_SIGNING): extension files must be signed"
	depends on SOC_SERIES_ESP32S31
	help
	  Set by apps/common/sysbuild/signing.cmake. Then a key the build cannot use for the extension
	  signatures (not ED25519, unreadable) stops the build: accepting unsigned extensions in a build whose
	  image is signed would make the signature check a decoration.

config MULTIAPP_UNLOAD
	bool "Switch apps in place, unloading the running one"
	default y if SOC_SERIES_ESP32S3 || SOC_SERIES_ESP32S31
	select THREAD_MONITOR
	select SYS_HEAP_RUNTIME_STATS
	help
	  "multiapp run" stops the running app, unloads it and the modules the next one does not
	  need (the Wi-Fi driver, the SDR) and loads the next, when the two boots are compatible
	  (same USB profile, no console app). Otherwise, and when anything refuses to stop, it
	  reboots into the next app. Exercised on hardware on the ESP32-S3; the ESP32-S31 builds
	  with it, its radio module's down path is not yet tried on a board.

config MULTIAPP_STOP_TIMEOUT_MS
	int "How long an app's main() may take to end before the switch gives up"
	default 5000
	depends on MULTIAPP_UNLOAD

config MULTIAPP_STAGES
	bool "Hot-swap a DSP stage of the running app (development)"
	default y if SOC_SERIES_ESP32S3 || SOC_SERIES_ESP32S31
	depends on MULTIAPP_UNLOAD
	help
	  An app declares stages (include/multiapp/stage.h, MULTIAPP_STAGE_DEFINE()); "multiapp stage"
	  loads a small kernel (multiapp_kernel() in CMakeLists.txt, a file uploaded over the shell
	  or read from the volume) into the running app and swaps one stage to it at the app's
	  quiescent point, then unloads the old kernel, all without a reboot
	  (doc/apps/multiapp-internals.md, "Hot-swapping a stage"; apps/multiapp/scripts/kswap.py).
	  A development feature: it runs code of your choosing, so it belongs off in a product.

config MULTIAPP_STAGE_TIMEOUT_MS
	int "How long a swap waits for the app's sync point, ms"
	default 2000
	depends on MULTIAPP_STAGES
	help
	  After it the request is taken back, the new kernel unloaded and the shell says that the app
	  never got there. The shell commands take another value as a last argument.

config MULTIAPP_KERNEL_MAX_KB
	int "Largest kernel file, KiB"
	default 16
	depends on MULTIAPP_STAGES
	help
	  The PSRAM buffer an upload or a file is read into before llext copies it.

config MULTIAPP_KERNELS_IN_VOLUME
	bool "The kernels' files also go into the FAT volume image"
	depends on MULTIAPP_STAGES
	help
	  For "multiapp stage load" without a copy first; the kernels are never in multiapp_embedded[]
	  and never change the build id of the apps' files.

config MULTIAPP_WIFI
	bool "The stock Wi-Fi driver as a module"
	depends on DT_HAS_ESPRESSIF_ESP32_WIFI_ENABLED
	depends on ZEPHYR_HAL_ESPRESSIF_MODULE_BLOBS
	select WIFI
	select WIFI_USE_NATIVE_NETWORKING
	select NET_L2_WIFI_MGMT
	select NET_L2_ETHERNET_MGMT
	select THREAD_CUSTOM_DATA
	select EVENTS
	select THREAD_STACK_INFO
	help
	  The driver and its blobs are a module, wifi.llext on the volume, which
	  only the boots of an app that needs it load. The host has its
	  network interface (src/wifi_netif.c), down in every other boot, and
	  what the driver needs from the kernel and the network stack.

config MULTIAPP_MICROPYTHON
	bool "MicroPython as an app"
	depends on ZEPHYR_MICROPYTHON_MODULE
	help
	  The port, its C modules and frozen Python are one extension,
	  micropython.llext on the volume (micropython.cmake). The host keeps
	  what they need from the kernel, /FLASH: and the USB device; "multiapp
	  run micropython" reboots into its REPL on the CDC-ACM port. On the
	  ESP32-S31 the REPL is also what a plain "ssh <host>" gets
	  (doc/dev/network-services.md, "Phase 4").

config MULTIAPP_MICROPYTHON_STACK
	int "MicroPython thread stack on the ESP32-S31, bytes (PSRAM)"
	depends on MULTIAPP_MICROPYTHON && SOC_SERIES_ESP32S31
	default 32768
	help
	  In PSRAM, in the extension's bss: Python's recursion needs depth that internal RAM cannot
	  spare (8 KB gave a recursion depth of 11). A thread with its stack in PSRAM must never touch
	  the flash itself (the cache is off during a flash operation): what MicroPython calls that
	  can, esdr.shell(), runs on a worker with an internal stack, and src/flashguard.c refuses a
	  flash operation of such a thread. esdr.stacks() gives the peak.

config MULTIAPP_MICROPYTHON_WORKER_STACK
	int "Stack of the worker that runs MicroPython's flash accesses, bytes (internal)"
	depends on MULTIAPP_MICROPYTHON && SOC_SERIES_ESP32S31
	default 2144
	help
	  From the libc arena, when esdr.shell() or a calibration request first needs it; it has no guard,
	  an overflow would corrupt the arena. Sized by the stack headroom rule (at most 90 % used) from
	  the peak measured on an ESP32-S31-Function-CoreBoard (esdr.stacks(), 2026-11-27, with a 4096
	  byte stack): 1916 bytes over the HIL set, which reads and writes the volume and the settings
	  (multiapp list, info and crash, kernel thread stacks, net iface, ssh status, ssh key add, list
	  and remove, ssh keys reload, mcumgr arm and disarm, fs ls and statvfs, settings list). The
	  read-only commands alone peaked at 1112. 1916 / 0.9 rounded up to 16 bytes is 2144. A log
	  line says when a job has used 90 % of it, and the HIL test asserts the rule.

config MULTIAPP_MICROPYTHON_STACK_MARGIN
	int "Stack left to C callouts below MicroPython's recursion limit, bytes"
	depends on MULTIAPP_MICROPYTHON && SOC_SERIES_ESP32S31
	default 1024
	help
	  MicroPython stops recursing when the stack has this much left (MICROPY_STACK_CHECK_MARGIN).
	  What runs past that point (the compiler, imports, an esdr call; host commands run on the
	  worker) needs the deepest C stack of them over 0.9: the peak of a recursion test past the
	  limit, from esdr.stacks(). Measured on the board (2026-11-27): a recursion goes 280 bytes
	  past the limit, esdr.shell() at the deepest level stays below it; 280 / 0.9 is 311, so 1024
	  holds.

config MULTIAPP_MICROPYTHON_ARENA_USE
	int "Measured libc arena use of everything else after MicroPython starts, bytes (0: not measured)"
	depends on MULTIAPP_MICROPYTHON && SOC_SERIES_ESP32S31
	default 0
	help
	  The build fails when the arena is smaller than this plus the worker's stack
	  (scripts/tcm_groups.py --mp-ext). Unmeasured, 8192 bytes are assumed. To measure: after the
	  HIL run, esdr.stacks()[5] is the arena's allocated bytes now; less the worker's stack (it is
	  in them) is what the rest of the host takes.

config MULTIAPP_MICROPYTHON_GUI
	bool "MicroPython with a display"
	depends on MULTIAPP_MICROPYTHON
	help
	  Its extension also builds LVGL and the drivers of the board's display,
	  input devices and SD card, and freezes the launcher's apps. The
	  devicetree must have the board's peripherals; the host has no driver
	  for them.

config MULTIAPP_OSMOSDR_HS_LOAD_LOG
	bool "osmosdr_hs logs the CPU its stream leaves (a bench)"
	depends on SOC_SERIES_ESP32S31
	help
	  osmosdr_hs with its loadlog.conf, as its standalone bench build: a low
	  priority thread counts what it gets, and the log has it every 10 s.

config MULTIAPP_EMBEDDED
	bool "Apps built into the image too"
	default y
	help
	  Each app is also built into the image, loaded when the FAT volume has
	  no good file for it. Without, an app runs only from its file.

config MULTIAPP_FILE_MAX_KB
	int "Largest app file, KiB"
	default 2048
	help
	  The PSRAM buffer a boot reads the app's file into before loading it.

config MULTIAPP_AREA_SIZE
	int "Bytes of internal RAM the apps share, one per boot"
	# No app on the ESP32-S31 has buffers in the area.
	default 16 if SOC_SERIES_ESP32S31
	default 24128
	help
	  In the high region: the buffers an app defines with
	  ESP_SDR_HIGH_BUF_DEFINE() and ESP_SDR_HIGH_STACK_DEFINE() (osmosdr's
	  USB blocks, ring and USB thread stacks), or in other boots the 802.15.4
	  driver's buffers.

config MULTIAPP_RUNNING_AFTER_MS
	int "Mark an app as running once its main() has run this long, ms"
	default 3000
	help
	  A boot that dies on the way to its app is skipped once, to end a crash loop: the record of how
	  far it got (src/apps.c) says "running" when main() returns. An app whose main() never
	  returns (osmosdr_hs) would stay "in main" for ever, and a warm reboot would skip its autostart
	  once. This many milliseconds after main() starts, with the app still the one that started,
	  the record says "running" too; an app that dies earlier stays a crash-loop suspect. 0:
	  only when main() returns.

config MULTIAPP_AUTOSTART
	string "App to start at boot"
	default ""
	help
	  Started when no "multiapp run" request is pending from before a reset.
	  Empty: none, start one with "multiapp run <name>".

config LLEXT_EXPORT_SYMBOL_GROUP_MULTIAPP
	def_bool y
	help
	  What the embedded extensions import, exported by exports.py. Zephyr's
	  default groups (every syscall, a libc subset) stay off: what they
	  export is kept by the linker, kernel code in IRAM included.

