/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * What the PHY module (the PHY and RF test blobs, the HAL's glue and the radio arbiter) exports.
 * The linker keeps only what these reach (--gc-sections): the blobs hold test code that calls
 * functions the host does not have. A symbol missing here fails the host's link, through
 * exports.py. The sdr and wifi modules and the apps import from here.
 */
{
	global:
		/* The sdr module, and the host's PHY users. */
		esp_phy_enable;
		esp_wifi_bt_power_domain_on;
		force_rx_gain;
		force_tx_gain;
		force_txon_mode;
		get_phy_version_str;
		phy_wifi_enable_set;
		rom_pbus_xpd_tx_on;
		set_chanfreq;
		set_rf_freq_offset;
		stop_tx_tone;

		/* The wifi module's esp_adapter.c and wifi_init.c. */
		esp_phy_disable;
		esp_phy_modem_init;
		esp_phy_modem_deinit;
		esp_phy_update_country_info;
		esp_wifi_power_domain_on;
		esp_wifi_power_domain_off;

		/* The wifi module's libnet80211 and libpp. */
		ant_dft_cfg;
		ant_wifirx_cfg;
		ant_wifitx_cfg;
		chip_v7_set_chan_misc;
		noise_check_loop;
		phy_change_channel;
		phy_disable_low_rate;
		phy_enable_low_rate;
		phy_set_most_tpw;
		register_chipv7_phy_init_param;
		set_rx_sense;
		phy_get_most_tpw;
		phy_chan_dump_cfg;
		phy_chan_filt_set;

		/* The radio arbiter (esp_sdr_arb.c): the wifi module's wrapped power calls... */
		__wrap_esp_phy_enable;
		__wrap_esp_phy_disable;
		/* ...and what the sdr module, the wifi module and the apps call (esp_sdr_arb.h). */
		esp_sdr_arb_claim;
		esp_sdr_arb_gate;
		esp_sdr_arb_get_stats;
		esp_sdr_arb_holds;
		esp_sdr_arb_now_us;
		esp_sdr_arb_release;
		esp_sdr_arb_reset_stats;
		esp_sdr_arb_set_ops;
		esp_sdr_arb_step;
		esp_sdr_arb_set_stop_hook;
		esp_sdr_arb_shutdown;
		esp_sdr_arb_wifi_attach;
		esp_sdr_arb_wifi_attached;
		esp_sdr_arb_wifi_detach;
		esp_sdr_arb_wifi_awake;
		esp_sdr_arb_wifi_set_channel;
		esp_sdr_arb_window_over;

		/* The host: the module's inverse (src/apps.c). */
		multiapp_module_down;
	local:
		*;
};
