 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * Hackaday Communicator badge: the board's 428x142 display and keyboard, no SD card.
 */

#include "communicator_badge_periph.dtsi"

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};

	/* The FAT volume "FLASH", mounted at /FLASH:, shared with the USB host. */
	fat_disk: fat_disk {
		compatible = "zephyr,flash-disk";
		partition = <&fat_partition>;
		disk-name = "FLASH";
		cache-size = <4096>;
	};

	fstab {
		compatible = "zephyr,fstab";

		flash_fs: flash_fs {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/FLASH:";
			disk-access;
		};
	};
};

zephyr_udc0: &usb_otg {
	status = "okay";

	/* The REPL's console while OTG owns the USB port. */
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "ESP-SDR MicroPython REPL";
	};
};

#include "partitions.dtsi"
