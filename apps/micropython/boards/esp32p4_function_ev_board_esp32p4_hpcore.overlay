/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * ESP32-P4-Function-EV-Board, ESP32-P4: no display; the REPL on CDC-ACM and DFU on the USB 2.0
 * OTG HS port (USB-C); boot messages on the USB-UART (UART0); the radio is the board's
 * ESP32-C6 on SDIO.
 */

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		/* The radio: the C6's osmosdr_serial (cmod/esdr_remote.c) over SDIO. */
		esdr,link-sdio = &sdhc1;
		/delete-property/ zephyr,display;
		/delete-property/ zephyr,touch;
	};

	/* GPIO54 is the ESP32-C6's enable (cmod/esdr_usb.c drives it). */
	zephyr,user {
		c6-enable-gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>;
	};

	/* The FAT volume "FLASH", mounted at /FLASH:, and the SD card at /SD:. */
	fat_disk: fat_disk {
		compatible = "zephyr,flash-disk";
		partition = <&fat_partition>;
		disk-name = "FLASH";
		cache-size = <4096>;
	};

	fstab {
		compatible = "zephyr,fstab";

		flash_fs: flash_fs {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/FLASH:";
			disk-access;
		};

		/* The microSD card (sdhc0), if one mounts; never formatted (esdr_radio.c sets
		 * FS_MOUNT_FLAG_NO_FORMAT).
		 */
		sd_fs: sd_fs {
			compatible = "zephyr,fstab,fatfs";
			mount-point = "/SD:";
			disk-access;
		};
	};
};

/* The ESP32-C6 runs the radio firmware, not esp-hosted, whose driver would reset it. */
&esp_hosted_mcu {
	status = "disabled";
};

zephyr_udc0: &usb_otg {
	status = "okay";
	/*
	 * An IN endpoint is bulk capable only with a FIFO of a whole high-speed packet (512 bytes,
	 * 128 words). The SoC gives that to one, which CDC-ACM's notification endpoint takes
	 * first: its bulk IN endpoint needs a second.
	 */
	g-tx-fifo-size = <128 128 64 64 64 64 64>;

	/* The REPL's console. */
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "ESP-SDR MicroPython REPL";
	};
};

#include "partitions_p4.dtsi"
