- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "# SPDX-License-Identifier: GPL-3.0-or-later\n\"\"\"Two-way link:\
      \ short messages, numbered, acknowledged, sent again until acknowledged.\n\n\
      In: send (the text: a QT GUI Msg Push Button's pair, a symbol, a string), rx\
      \ (PDUs from the\nreceiver), tick (a Message Strobe, the block's clock). Out:\
      \ tx (PDUs for the modulator), and\npairs for QT GUI Labels through Message\
      \ Pair to Var blocks: rx (the last message heard), tx\n(messages sent, acknowledged,\
      \ sent again, lost), link (what the receiver measured on the last\nframe: SNR,\
      \ level, carrier offset; frames whose CRC failed), peer (the SNR the peer measured,\n\
      the round trip time, this end's id).\n\nFrame, the PDU after GNU Radio's default\
      \ packet header: kind (D data, A acknowledgement), the\nsender's id (2 bytes),\
      \ a sequence number; data carries the text, an acknowledgement the SNR its\n\
      sender measured (dB, 255 unknown). Then CRC-32 (little-endian) and two bytes\
      \ of padding that\npush the CRC through gfsk_mod's filter: GNU Radio holds a\
      \ packet's last symbols until more come.\nStop and wait: one message at a time,\
      \ sent again after timeout s plus up to half of it at\nrandom, up to retries\
      \ times. Auto sends a numbered message every period s (+-20 %).\n\"\"\"\n\n\
      import binascii\nimport os\nimport random\nimport time\n\nimport pmt\nfrom gnuradio\
      \ import gr\n\nDATA = 0x44\nACK = 0x41\nPAD = b\"\\x55\\x55\"\nTEXT_MAX = 40\n\
      QUEUE_MAX = 4\n\ntry:\n    _now = time.ticks_ms\n    _diff = time.ticks_diff\n\
      except AttributeError:\n    def _now():\n        return int(time.monotonic()\
      \ * 1000)\n\n    def _diff(a, b):\n        return a - b\n\n\ndef frame(kind,\
      \ node, seq, body):\n    b = bytes([kind, node >> 8, node & 255, seq & 255])\
      \ + body\n    return b + binascii.crc32(b).to_bytes(4, \"little\") + PAD\n\n\
      \ndef parse(data):\n    \"\"\"(kind, node, seq, body) of a frame whose CRC holds,\
      \ else None.\"\"\"\n    n = len(data) - 4 - len(PAD)\n    if n < 4 or binascii.crc32(data[:n])\
      \ != int.from_bytes(data[n:n + 4], \"little\"):\n        return None\n    return\
      \ data[0], (data[1] << 8) | data[2], data[3], data[4:n]\n\n\ndef _text(b):\n\
      \    try:\n        s = b.decode()\n    except Exception:\n        s = repr(b)\n\
      \    return \"\".join(c if \" \" <= c <= \"~\" else \"?\" for c in s)\n\n\n\
      class blk(gr.basic_block):\n    \"\"\"Two-way link (stop and wait)\"\"\"\n\n\
      \    def __init__(self, auto=False, period=2.0, timeout=0.4, retries=5):\n \
      \       gr.basic_block.__init__(self, name=\"Two-way link\", in_sig=None, out_sig=None)\n\
      \        self.auto = auto\n        self.period = period\n        self.timeout\
      \ = timeout\n        self.retries = retries\n        for port, handler in ((\"\
      send\", self._send), (\"rx\", self._rx), (\"tick\", self._tick)):\n        \
      \    self.message_port_register_in(pmt.intern(port))\n            self.set_msg_handler(pmt.intern(port),\
      \ handler)\n        for port in (\"tx\", \"rx_text\", \"tx_text\", \"link_text\"\
      , \"peer_text\"):\n            self.message_port_register_out(pmt.intern(port))\n\
      \        seed = os.urandom(4)\n        random.seed(int.from_bytes(seed, \"little\"\
      ))\n        self.node = int.from_bytes(seed[:2], \"little\")\n        self.seq\
      \ = 0\n        self.queue = []\n        self.out = None  # [seq, frame, sends,\
      \ last send, first send, wait]\n        self.count = 0\n        self.next_auto\
      \ = None\n        self.last = {}\n        self.n = {\"msgs\": 0, \"acked\":\
      \ 0, \"retries\": 0, \"lost\": 0, \"heard\": 0, \"dup\": 0,\n              \
      \    \"bad\": 0}\n        self.heard = \"-\"\n        self.snr = self.rssi =\
      \ self.offset = self.peer_snr = self.rtt = None\n        self.shown = {}\n \
      \       self.show_t = None\n\n    def _pub(self, data):\n        self.message_port_pub(pmt.intern(\"\
      tx\"), pmt.cons(pmt.make_dict(),\n                                         \
      \                pmt.init_u8vector(len(data), list(data))))\n\n    def _send(self,\
      \ msg):\n        if pmt.is_pair(msg):\n            msg = pmt.cdr(msg)\n    \
      \    if pmt.is_symbol(msg):\n            text = pmt.symbol_to_string(msg)\n\
      \        else:\n            text = str(pmt.to_python(msg))\n        if len(self.queue)\
      \ < QUEUE_MAX:\n            self.queue.append(text)\n        self._next(_now())\n\
      \n    def _next(self, now):\n        if self.out is not None or not self.queue:\n\
      \            return\n        self.seq = (self.seq + 1) & 255\n        f = frame(DATA,\
      \ self.node, self.seq, self.queue.pop(0).encode()[:TEXT_MAX])\n        self.out\
      \ = [self.seq, f, 1, now, now, self._wait()]\n        self.n[\"msgs\"] += 1\n\
      \        self._pub(f)\n        self._show(now, True)\n\n    def _wait(self):\n\
      \        return int(1000 * self.timeout * (1 + random.random() / 2))\n\n   \
      \ def _tick(self, msg):\n        now = _now()\n        o = self.out\n      \
      \  if o is not None and _diff(now, o[3]) >= o[5]:\n            if o[2] <= self.retries:\n\
      \                o[2] += 1\n                o[3] = now\n                o[5]\
      \ = self._wait()\n                self.n[\"retries\"] += 1\n               \
      \ self._pub(o[1])\n            else:\n                self.n[\"lost\"] += 1\n\
      \                self.out = None\n        if self.auto and self.period > 0:\n\
      \            if self.next_auto is None or _diff(now, self.next_auto) >= 0:\n\
      \                self.next_auto = now + int(1000 * self.period * (0.8 + 0.4\
      \ * random.random()))\n                if not self.queue and self.out is None:\n\
      \                    self.count += 1\n                    self.queue.append(\"\
      auto {}\".format(self.count))\n        else:\n            self.next_auto = None\n\
      \        self._next(now)\n        self._show(now)\n\n    def _rx(self, msg):\n\
      \        now = _now()\n        meta = pmt.to_python(pmt.car(msg)) if pmt.is_dict(pmt.car(msg))\
      \ else None\n        if not isinstance(meta, dict):  # GNU Radio gives None\
      \ for an empty one\n            meta = {}\n        f = parse(bytes(pmt.u8vector_elements(pmt.cdr(msg))))\n\
      \        if f is None:\n            self.n[\"bad\"] += 1\n            self._show(now,\
      \ True)\n            return\n        kind, node, seq, body = f\n        if node\
      \ == self.node:\n            return\n        for key in (\"snr\", \"rssi\"):\n\
      \            if key in meta:\n                setattr(self, key, meta[key])\n\
      \        if \"freq_offset\" in meta:\n            self.offset = meta[\"freq_offset\"\
      ]\n        if kind == DATA:\n            snr = 255 if self.snr is None else\
      \ max(0, min(254, int(self.snr + 0.5)))\n            self._pub(frame(ACK, self.node,\
      \ seq, bytes([snr])))\n            if self.last.get(node) == seq:\n        \
      \        self.n[\"dup\"] += 1\n            else:\n                self.last[node]\
      \ = seq\n                self.n[\"heard\"] += 1\n                self.heard\
      \ = \"{:04x} #{}: {}\".format(node, seq, _text(body))\n        elif kind ==\
      \ ACK and self.out is not None and seq == self.out[0]:\n            self.n[\"\
      acked\"] += 1\n            self.rtt = _diff(now, self.out[3])\n            self.peer_snr\
      \ = body[0] if body and body[0] != 255 else None\n            self.out = None\n\
      \            self._next(now)\n        self._show(now, True)\n\n    def _show(self,\
      \ now, force=False):\n        if not force and self.show_t is not None and _diff(now,\
      \ self.show_t) < 500:\n            return\n        self.show_t = now\n     \
      \   n = self.n\n        texts = {\n            \"rx_text\": self.heard,\n  \
      \          \"tx_text\": \"{} sent, {} acked, {} again, {} lost{}\".format(\n\
      \                n[\"msgs\"], n[\"acked\"], n[\"retries\"], n[\"lost\"],\n \
      \               \" (#{})\".format(self.out[0]) if self.out else \"\"),\n   \
      \         \"link_text\": \"{}, {}, {}, {} bad\".format(\n                \"\
      - dB\" if self.snr is None else \"{:.0f} dB\".format(self.snr),\n          \
      \      \"-\" if self.rssi is None else \"{:.0f} dBFS\".format(self.rssi),\n\
      \                \"-\" if self.offset is None else \"{:+.1f} kHz\".format(self.offset\
      \ / 1000),\n                n[\"bad\"]),\n            \"peer_text\": \"{}, rtt\
      \ {}, me {:04x}\".format(\n                \"- dB\" if self.peer_snr is None\
      \ else \"{} dB\".format(self.peer_snr),\n                \"-\" if self.rtt is\
      \ None else \"{} ms\".format(self.rtt), self.node),\n        }\n        for\
      \ port, text in texts.items():\n            if self.shown.get(port) != text:\n\
      \                self.shown[port] = text\n                self.message_port_pub(pmt.intern(port),\
      \ pmt.cons(pmt.intern(port),\n                                             \
      \                    pmt.intern(text)))\n"
    affinity: ''
    alias: ''
    auto: auto
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    period: '2.0'
    retries: '5'
    timeout: '0.4'
  states:
    _io_cache: ('Two-way link', 'blk', [('auto', 'False'), ('period', '2.0'), ('timeout',
      '0.4'), ('retries', '5')], [('tick', 'message', 1), ('rx', 'message', 1), ('send',
      'message', 1)], [('peer_text', 'message', 1), ('link_text', 'message', 1), ('tx_text',
      'message', 1), ('rx_text', 'message', 1), ('tx', 'message', 1)], 'Two-way link
      (stop and wait)', ['auto', 'period', 'retries', 'timeout'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 544.0]
    rotation: 0
    state: enabled
