/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * The WHY2025 badge's ESP32-P4: USB-C port J8 on its OTG HS controller (GPIO2 low, the
 * board's default), the C6 on sdhc1 (apps/osmosdr_serial with CONFIG_APP_LINK_SDIO).
 */

/ {
	chosen {
		esdr,link-sdio = &sdhc1;
	};

	/* GPIO2 hands USB-C port J8 to the ESP32-C6; GPIO12 is its enable. */
	zephyr,user {
		usb-mux-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		c6-enable-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
	};
};

&esp_hosted_mcu {
	status = "disabled";
};

zephyr_udc0: &usb_otg {
	status = "okay";
};
