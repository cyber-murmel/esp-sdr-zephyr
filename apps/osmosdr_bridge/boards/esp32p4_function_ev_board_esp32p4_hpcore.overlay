/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * The ESP32-P4-Function-EV-Board's ESP32-P4: its USB 2.0 OTG HS port (USB-C), the C6 on sdhc1
 * (apps/osmosdr_serial with CONFIG_APP_LINK_SDIO, installed by apps/c6_bootstrap).
 */

/ {
	chosen {
		esdr,link-sdio = &sdhc1;
	};

	/* GPIO54 is the ESP32-C6's enable. */
	zephyr,user {
		c6-enable-gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>;
	};
};

&esp_hosted_mcu {
	status = "disabled";
};

zephyr_udc0: &usb_otg {
	status = "okay";
};
