config ESP_SDR_IEEE802154
	bool "IEEE 802.15.4 radio on esp_sdr"
	depends on ESP_SDR_TX_DAC && NETWORKING && IEEE802154 && HWINFO
	help
	  Software 2.4 GHz O-QPSK PHY and an ieee802154_radio_api driver
	  (device "esp_sdr_154"): receive gapless through the ring
	  (ESP_SDR_IEEE802154_RING) or from 16 MS/s bank captures, transmit
	  through the DAC backend. With CONFIG_NET_L2_IEEE802154 it is a
	  network interface; without, a plain device whose frames go to
	  ieee154_esp_sdr_set_rx_cb() (raw 802.15.4 mode would compile out
	  the interface layer the Wi-Fi driver needs). Waits for ACKs; does
	  not send them, and has no CCA or address filtering: see
	  doc/ieee802154.md. Needs CONFIG_IEEE802154 (packet fields) and
	  CONFIG_HWINFO (the extended address comes from the chip's id).

if ESP_SDR_IEEE802154

config ESP_SDR_IEEE802154_RING
	bool "Gapless receive through the ring"
	default y
	depends on ESP_SDR_RING && SMP
	select ESP_SDR_RING_BOX4
	help
	  The 16 MS/s ring decimated by 4 (ESP_SDR_RING_DECIM_BOX4) on CPU 1,
	  the PHY on CPU 0 through a sample ring in internal RAM. Without it, receive
	  uses separate bank captures of about 1 ms.

config ESP_SDR_IEEE802154_RX_PRIORITY
	int "Receive thread priority (ring or burst captures)"
	default 10

config ESP_SDR_IEEE802154_PHY_PRIORITY
	int "PHY thread priority with the ring"
	default 14
	help
	  The PHY drains the sample ring whenever samples wait. Keep it below
	  USB, network and shell threads: if it falls behind it drops samples
	  instead of starving them.

module = ESP_SDR_IEEE802154
module-str = esp_sdr_ieee802154
source "subsys/logging/Kconfig.template.log_config"

endif # ESP_SDR_IEEE802154
