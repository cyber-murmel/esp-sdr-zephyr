#
# Placement rules for include/esp_sdr/esp_sdr_place.h: the generated esp_sdr_place_rules.h includes
# the rule headers that exist, in this order, the first definition of a rule counting:
#   <app>/boards/<normalized board target>.place.h, <app>/place.h,
#   lib/esp_sdr/place/boards/<normalized board target>.h, lib/esp_sdr/place/<SoC series>.h.
# <app> is APPLICATION_CONFIG_DIR, the app's own directory unless a test builds an app from there
# (tests/regression: its image must be the app's).
# Included by lib/esp_sdr and by apps/common (for SoCs the library does not build for).
#
# With CONFIG_ESP_SDR_HOT_TEXT (ESP32-S3) the hot flash block (hot_text.ld.in): what the rules
# place in ESP_SDR_HOTBLOCK and the app's list, esp_sdr_hot_text(<list file>), whose statements
# claim input sections from the flash text's catch-all (scripts/place/hot_text.py writes them from
# profiles).
# It needs the TEXT_SECTIONS hook of the SoC's linker script: CMake stops without it, and so does
# the link (hot_text_check.ld) should the snippet not reach the image.
#
# Each build then writes zephyr/place_report.txt (scripts/place/place_report.py): bytes per memory
# region and per usage category, the room left, the tags with no symbol and where they were
# inlined, the untagged code and data of 1 KB or more. -DESP_SDR_PLACE_REPORT=OFF leaves it out.

include_guard(GLOBAL)

set(esp_sdr_place_dir ${CMAKE_CURRENT_LIST_DIR}/place)
set(esp_sdr_place_rules_h ${ZEPHYR_BINARY_DIR}/include/generated/esp_sdr_place_rules.h)
set(esp_sdr_place_text
  "/* Generated by lib/esp_sdr/place.cmake: the placement rules, first wins. */\n")
foreach(rules
    ${APPLICATION_CONFIG_DIR}/boards/${NORMALIZED_BOARD_TARGET}.place.h
    ${APPLICATION_CONFIG_DIR}/place.h
    ${esp_sdr_place_dir}/boards/${NORMALIZED_BOARD_TARGET}.h
    ${esp_sdr_place_dir}/${CONFIG_SOC_SERIES}.h)
  if(EXISTS ${rules})
    string(APPEND esp_sdr_place_text "#include \"${rules}\"\n")
  endif()
endforeach()
file(CONFIGURE OUTPUT ${esp_sdr_place_rules_h} CONTENT "${esp_sdr_place_text}")

option(ESP_SDR_PLACE_REPORT "Write zephyr/place_report.txt after the link" ON)
if(ESP_SDR_PLACE_REPORT)
  set(esp_sdr_place_report ${ZEPHYR_BINARY_DIR}/place_report.txt)
  set(esp_sdr_place_report_cmd ${PYTHON_EXECUTABLE}
    ${CMAKE_CURRENT_LIST_DIR}/../../scripts/place/place_report.py
    ${ZEPHYR_BINARY_DIR}/${CONFIG_KERNEL_BIN_NAME}.elf
    --sources ${CMAKE_BINARY_DIR}/compile_commands.json --inlined --untagged 1024
    --out ${esp_sdr_place_report} --quiet)
  if(DEFINED logical_target_for_zephyr_elf)
    # From an app, after Zephyr has set its post-build steps: a target after the link.
    add_custom_target(esp_sdr_place_report ALL COMMAND ${esp_sdr_place_report_cmd}
      BYPRODUCTS ${esp_sdr_place_report})
    add_dependencies(esp_sdr_place_report ${logical_target_for_zephyr_elf})
  else()
    set_property(GLOBAL APPEND PROPERTY extra_post_build_commands
      COMMAND ${esp_sdr_place_report_cmd})
    set_property(GLOBAL APPEND PROPERTY extra_post_build_byproducts ${esp_sdr_place_report})
  endif()
endif()

# The hot flash block (hot_text.cmake).
include(${CMAKE_CURRENT_LIST_DIR}/hot_text.cmake)
if(CONFIG_ESP_SDR_HOT_TEXT)
  esp_sdr_hot_text_hook_check(${SOC_LINKER_SCRIPT})
  esp_sdr_hot_text_configure("/* No list: what the rules place in ESP_SDR_HOTBLOCK only. */")
  zephyr_linker_sources(TEXT_SECTIONS ${ZEPHYR_BINARY_DIR}/esp_sdr_hot_text.ld)
  zephyr_linker_sources(SECTIONS ${CMAKE_CURRENT_LIST_DIR}/hot_text_check.ld)
endif()
