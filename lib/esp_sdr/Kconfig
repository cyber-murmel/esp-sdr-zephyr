config ESP_SDR
	bool "ESP-SDR raw I/Q receiver"
	depends on SOC_SERIES_ESP32S3 || SOC_SERIES_ESP32C6 || SOC_SERIES_ESP32C5
	depends on WIFI_ESP32
	# The bank and heap limits assume no APPCPU image in SRAM.
	depends on !SOC_ENABLE_APPCPU
	help
	  Burst capture of raw baseband I/Q samples from the Wi-Fi receiver,
	  ported from ESPARGOS esp-sdr. Reserves an SRAM bank for the capture
	  engine (64 KiB on the S3, the 128 KiB block 2 on the C6). The
	  ESP32-C6 captures at 80 MS/s only, and streams continuously,
	  CPU-paced (ESP_SDR_PACED). The ESP32-C5 receives at 80 to 4 MS/s
	  into its 128 KiB block 1, which splits the image around it, streams
	  like the C6 or gapless through the diagnostic bus (ESP_SDR_DIAG),
	  and loops waveforms through its DAC engine (ESP_SDR_REPLAY).

if ESP_SDR

config ESP_SDR_RFTEST
	bool "Espressif RF test library (fixed RX gain, TX power steps)"
	default y
	help
	  Links force_rx_gain(), force_tx_gain() and force_txon_mode() from
	  Espressif's librftest.a, fetched with "west blobs fetch
	  esp-sdr-zephyr". Without it the receiver runs on the hardware AGC
	  only and transmit keeps the PHY's own power setting.

config ESP_SDR_RX_DECIM
	bool "Decimated capture"
	default y
	help
	  esp_sdr_rx_capture_decimated(): a full capture filtered and
	  decimated by a third order CIC, for narrow band streams.
	  esp_sdr_rx_capture_folded(): the same capture folded (decimated in
	  frequency, aliasing the whole band down) instead of filtered, for a
	  wideband power/occupancy survey. Apps that work at the native rate
	  can leave it out.

config ESP_SDR_PACED
	bool "CPU-paced streaming (ESP32-C6, ESP32-C5)"
	default y
	depends on (SOC_SERIES_ESP32C6 || SOC_SERIES_ESP32C5) && ESP_SDR_RFTEST
	help
	  esp_sdr_rx_paced_*() and esp_sdr_tx_paced_*(): continuous receive
	  through the modem's IQ estimator and continuous transmit through the
	  TX DC value register, paced by the CPU from the caller's loop.

config ESP_SDR_DIAG
	bool "Gapless receive through the modem diagnostic bus (ESP32-C5)"
	depends on SOC_SERIES_ESP32C5 && ESP_SDR_PACED
	help
	  esp_sdr_diag_run(): the dump engine runs free, the GPIO matrix loops
	  the modem diagnostic bus back into the PARLIO receiver, and a GDMA
	  ring in SRAM bank 1 collects 4 bits of I and 4 bits of Q at 40 MS/s
	  without the CPU. Drives 8 pads as outputs while it runs. Takes the
	  bank of the capture engine and the radio for the whole run.

config ESP_SDR_REPLAY
	bool "Loop replay through the DAC engine (ESP32-C5)"
	depends on SOC_SERIES_ESP32C5 && ESP_SDR_PACED
	help
	  esp_sdr_replay_*(): the modem DAC engine plays up to 16383 words
	  out of the dump bank at 80 or 40 MS/s, once, a number of times or
	  endlessly, without the CPU. Periodic content only: the engine owns
	  the bank while it plays.

config ESP_SDR_BANK1
	bool "Reserve a second dump bank"
	depends on SOC_SERIES_ESP32S3
	help
	  Reserves SRAM bank 1 (0x3fcc0000) next to the capture bank, for
	  two-bank loop playback (esp_sdr_tx_loop_*()) and for captures into
	  either bank (esp_sdr_rx_capture_bank()). Costs another 64 KiB of
	  internal RAM.

config ESP_SDR_RING
	bool "Continuous ring receive"
	depends on SOC_SERIES_ESP32S3
	select ESP_SDR_BANK1
	help
	  esp_sdr_ring_run(): the dump engine in circular mode, rotated
	  through SRAM banks 0 to 2, and a two-stage decimating FIR on the
	  vector unit: gapless I/Q at 16 MS/s divided by 64 to 1024. Reserves
	  SRAM bank 0 (0x3fcb0000) besides banks 1 and 2, another 64 KiB of
	  internal RAM: the whole DRAM image must end below 0x3fcb0000.

config ESP_SDR_RING_BOX4
	bool "Ring decimation by 4 (boxcar, for 2 MHz wide signals)"
	depends on ESP_SDR_RING
	help
	  ESP_SDR_RING_DECIM_BOX4: -fs/4 mix and a boxcar of 4 (or every 4th
	  pair) instead of the FIR chain, for signals such as IEEE 802.15.4 at
	  4 MS/s. About 1 KiB of IRAM, which on the S3 comes out of the same
	  SRAM as the DRAM image: leave it out where that is tight.

config ESP_SDR_RING_RAW
	bool "Ring without decimation (the unpacked 16 MS/s stream to the sink)"
	depends on ESP_SDR_RING
	help
	  ESP_SDR_RING_DECIM_RAW: the sink gets the whole stream as int16
	  pairs in chunks of up to 512, with 64 pairs of history in front,
	  for a consumer on the other CPU.

config ESP_SDR_RING_FIR
	bool "Ring decimation by 64 to 1024 (the two-stage FIR)"
	depends on ESP_SDR_RING
	default y
	help
	  ESP_SDR_RING_DECIM_MIN to ESP_SDR_RING_DECIM_MAX. An image that
	  runs the ring only raw or by 4 can leave the filter out: about
	  1 KiB of IRAM, which on the S3 comes out of the same SRAM as the
	  DRAM image.

config ESP_SDR_CHANCAP
	bool "Channelized burst capture"
	depends on ESP_SDR_RING && ESP_SPIRAM && SMP && SCHED_CPU_MASK
	select ESP_SDR_RING_RAW
	help
	  esp_sdr_chancap_start(): the ring without decimation into a
	  hand-over ring in SRAM bank 2, a channelizer (filter bank or
	  decimator bank) and a detector per channel on the other CPU, one
	  I/Q capture per packet per channel from a PSRAM slab to a callback
	  thread. Design: doc/chancap.md.

if ESP_SDR_CHANCAP

config ESP_SDR_CHANCAP_SIMD
	bool "Vector unit kernels for the 8-channel filter bank"
	default y
	help
	  The branch sums, twiddles and the DFT of an 8-channel bank on the
	  PIE (esp_sdr_chancap_pie.S), bit-exact with the C reference; other
	  geometries and the decimator bank run the C code.

config ESP_SDR_CHANCAP_SLAB_KB
	int "Capture slab in PSRAM, KiB"
	default 512
	help
	  Split at start into buffers of max_capture_us samples each.

config ESP_SDR_CHANCAP_QUEUE
	int "Finished captures waiting for the callback thread"
	default 32

config ESP_SDR_CHANCAP_RING_CPU
	int "CPU of the ring loop; the channelizer and callback run on the other"
	range 0 1
	default 1

config ESP_SDR_CHANCAP_DSP_PRIORITY
	int "Preemptive priority of the channelizer thread (the callback thread one below)"
	range 1 13
	default 1
	help
	  The highest preemptive priority: above the Wi-Fi driver's tasks (3
	  to 7), the USB stack's threads (8), the shell and the logging thread
	  (14). The channelizer is the real-time work of its CPU and must not
	  wait behind any of them, as the hand-over ring holds about 400 us.
	  It sleeps a tick whenever it has caught up and after an overrun, so
	  lower threads run even when the band is busier than it keeps up
	  with. The callback thread runs one priority lower: finished
	  captures leave while the channelizer sleeps. Nothing cooperative may
	  run on the channelizer's CPU: the chancap images set
	  CONFIG_SYSTEM_WORKQUEUE_PRIORITY=11 (the CDC-ACM class's work queue
	  takes it too), CONFIG_USBD_THREAD_PREEMPTIBLE and
	  CONFIG_UDC_DWC2_THREAD_PREEMPTIBLE, as each of those held the CPU
	  for hundreds of microseconds per USB transfer burst.

config ESP_SDR_CHANCAP_RING_STACK_SIZE
	int "Ring thread stack (internal RAM above the capture bank)"
	default 1536

config ESP_SDR_CHANCAP_DSP_STACK_SIZE
	int "Channelizer thread stack (internal RAM above the capture bank)"
	default 3072

config ESP_SDR_CHANCAP_OUT_STACK_SIZE
	int "Callback thread stack (internal RAM above the capture bank)"
	default 2048

endif # ESP_SDR_CHANCAP

config ESP_SDR_TX
	bool "Transmit backend interface"
	depends on SOC_SERIES_ESP32S3
	help
	  esp_sdr_tx_*() front end with a stub backend that consumes and
	  counts samples. A real backend registers with
	  esp_sdr_tx_set_backend().

config ESP_SDR_TX_DAC
	bool "DAC transmit backend"
	default y
	depends on ESP_SDR_TX && ESP_SPIRAM && ESP_SDR_RFTEST
	select ESP_SDR_BANK1
	help
	  Default backend: buffers input samples in PSRAM and interpolates
	  them to the 40 MS/s DAC rate in a player thread.

if ESP_SDR_TX_DAC

config ESP_SDR_TX_DAC_RING_SAMPLES
	int "Input ring size in samples (PSRAM, 4 bytes each, power of two)"
	default 262144

config ESP_SDR_TX_DAC_PREBUF_MS
	int "Input buffered before playback starts, in ms"
	default 20

config ESP_SDR_TX_DAC_SIMD
	bool "Interpolate with the ESP32-S3 vector unit"
	default y
	help
	  Four DAC words per instruction group (src/esp_sdr_pie.S). The
	  vector registers are not saved by Zephyr, so only the filler
	  threads may use them, with the scheduler locked meanwhile.

config ESP_SDR_TX_DAC_HIGH_RAM
	bool "Backend buffers and thread stacks above the capture bank"
	help
	  Puts the input staging buffer and the player and filler stacks
	  (about 7 KiB) in ESP_SDR_HIGH_RAM instead of the DRAM image, for
	  apps whose image must end below the ring banks.

config ESP_SDR_TX_DAC_STACK_SIZE
	int "Player and filler thread stack size"
	default 2048

config ESP_SDR_TX_DAC_PRIORITY
	int "Player thread priority"
	default 8
	help
	  Below the network and transmit receive threads, above the fillers:
	  it only copies ready blocks and restarts the DAC.

config ESP_SDR_TX_DAC_FILLER_PRIORITY
	int "Filler thread priority"
	default 5
	help
	  The leader fills one block per bank pass and sleeps until its switch
	  time, so it can sit above the application threads: any thread that
	  preempts it on its CPU for longer than the block tail (51 us) makes
	  the DAC restart.

config ESP_SDR_TX_DAC_LEADER_CPU
	int "CPU of the leading filler"
	range 0 1
	default 1
	help
	  The leader fills every block when the vector unit is available, the
	  other filler only helps the C fallback. Put the leader on the CPU
	  that is idle while transmitting: a transmit session holds the radio,
	  so receive capture waits and its processing CPU is free.

endif # ESP_SDR_TX_DAC

module = ESP_SDR
module-str = esp_sdr
source "subsys/logging/Kconfig.template.log_config"

endif # ESP_SDR
