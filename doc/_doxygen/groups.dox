 */

/**
 * @defgroup esp_sdr ESP-SDR library
 * @brief Raw I/Q receive and transmit on the Wi-Fi radio (CONFIG_ESP_SDR).
 *
 * One user of the radio at a time; all calls may sleep. The ESP32-S3 has the
 * whole library; the ESP32-C6 burst capture at 80 MS/s, triggered snapshots,
 * CPU-paced streaming and the gapless 80 MS/s receive; the ESP32-C5 bursts,
 * paced streaming, the diagnostic-bus ring and the DAC-engine replay.
 */

/**
 * @defgroup esp_sdr_radio Radio
 * @ingroup esp_sdr
 * @brief Bring-up, tuning, front end turnaround and housekeeping (esp_sdr.h).
 */

/**
 * @defgroup esp_sdr_rx Receive
 * @ingroup esp_sdr
 * @brief Gain, analog low-pass filter, burst and decimated capture (esp_sdr_rx.h).
 */

/**
 * @defgroup esp_sdr_tx Transmit
 * @ingroup esp_sdr
 * @brief Power steps, one-shot and loop playback, sweeps and streaming (esp_sdr_tx.h).
 */

/**
 * @defgroup esp_sdr_ring Continuous receive
 * @ingroup esp_sdr
 * @brief The gapless ring through three dump banks, ESP32-S3 (esp_sdr_ring.h).
 */

/**
 * @defgroup esp_sdr_chancap Channelized burst capture
 * @ingroup esp_sdr
 * @brief One I/Q capture per packet per channel of a uniform grid, from the ring on the
 * other CPU, ESP32-S3 (esp_sdr_chancap.h, CONFIG_ESP_SDR_CHANCAP).
 */

/**
 * @defgroup esp_sdr_diag Diagnostic-bus ring
 * @ingroup esp_sdr
 * @brief Gapless 40 MS/s receive through the modem diagnostic bus and PARLIO, ESP32-C5
 * (esp_sdr_diag.h, CONFIG_ESP_SDR_DIAG).
 */

/**
 * @defgroup esp_sdr_replay DAC-engine replay
 * @ingroup esp_sdr
 * @brief Waveform loops at 80 or 40 MS/s through the modem DAC engine, ESP32-C5
 * (esp_sdr_replay.h, CONFIG_ESP_SDR_REPLAY).
 */

/**
 * @defgroup esp_sdr_paced CPU-paced streaming
 * @ingroup esp_sdr
 * @brief Continuous receive and transmit, one sample at a time from the caller's loop,
 * ESP32-C6 and ESP32-C5 (esp_sdr_paced.h, CONFIG_ESP_SDR_PACED).
 */

/**
 * @defgroup esp_sdr_trig Triggered snapshots
 * @ingroup esp_sdr
 * @brief The full 80 MS/s kept from before a burst, ESP32-C6 (esp_sdr_trig.h,
 * CONFIG_ESP_SDR_TRIG).
 */

/**
 * @defgroup esp_sdr_gapless Gapless receive
 * @ingroup esp_sdr
 * @brief The whole 80 MS/s through a ring in SRAM blocks 1 and 2, pruned to the windows above
 * the noise, ESP32-C6 (esp_sdr_gapless.h, CONFIG_ESP_SDR_GAPLESS).
 */

/**
 * @defgroup ieee154 IEEE 802.15.4
 * @brief Software O-QPSK PHY and the esp_sdr radio driver (CONFIG_ESP_SDR_IEEE802154).
 */

/**
 * @defgroup ieee154_phy Software PHY
 * @ingroup ieee154
 * @brief Modulator and receiver, portable C (ieee154_phy.h).
 */

/**
 * @defgroup ieee154_esp_sdr Radio driver diagnostics
 * @ingroup ieee154
 * @brief Counters, measurements and traces of the esp_sdr_154 device (ieee154_esp_sdr.h).
 */

/**
 * @defgroup esp_sdr_dsp Signal processing helpers
 * @ingroup esp_sdr
 * @brief The turn constant, windows, sinc, FFT and whole-cycle tones, header only and free of
 * Zephyr (esp_sdr_dsp.h).
 */
