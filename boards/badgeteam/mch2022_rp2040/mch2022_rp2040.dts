/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * The RP2040 of the MCH2022 badge: it bridges USB to the ESP32 and the FPGA and holds their
 * reset lines, the buttons, the backlight, the IR LED and the SAO port. Its image sits behind
 * the badge's own bootloader, which stays in flash (doc/index.rst).
 */

/dts-v1/;

#include <freq.h>

#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "mch2022_rp2040-pinctrl.dtsi"

/ {
	model = "MCH2022 badge (RP2040 coprocessor)";
	compatible = "badgeteam,mch2022-rp2040-board";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &ssi;
		zephyr,code-partition = &code_partition;
	};

	aliases {
		watchdog0 = &wdt0;
	};

	zephyr,user {
		esp32-en-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		esp32-io0-gpios = <&gpio0 12 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
		/* Low: read the input registers. */
		esp32-int-gpios = <&gpio0 14 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
		fpga-creset-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
		fpga-cdone-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		charging-gpios = <&gpio0 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		/* In the order of the register bits: HOME, MENU, START, ACCEPT, BACK. */
		input1-gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 26 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		/* The joystick's A to E. SELECT is on QSPI_CSN, it is not a GPIO. */
		input2-gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			       <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		/* The SAO port's IO0, IO1 and the test points' PROTO_0, PROTO_1: register bits 0..3. */
		sao-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>,
			    <&gpio0 19 GPIO_ACTIVE_HIGH>,
			    <&gpio0 16 GPIO_ACTIVE_HIGH>,
			    <&gpio0 17 GPIO_ACTIVE_HIGH>;
		pwms = <&pwm 15 PWM_HZ(200) PWM_POLARITY_NORMAL>;
		/* VUSB, VBAT, the die's temperature. */
		io-channels = <&adc 2>, <&adc 3>, <&adc 4>;
	};
};

&xosc {
	/* As the stock firmware: some badges' crystals start slowly. */
	startup-delay-multiplier = <64>;
};

&flash0 {
	/* A W25Q16JV. */
	reg = <0x10000000 DT_SIZE_M(2)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(2)>;

	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		/* The badge's bootloader: never written here (doc/index.rst). */
		badge_bootloader: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "badge-bootloader";
			reg = <0x0 0x8000>;
			read-only;
		};

		/* {vector table, size, CRC-32} of the image, read by that bootloader. */
		image_header: partition@8000 {
			compatible = "zephyr,mapped-partition";
			label = "image-header";
			reg = <0x8000 0x8000>;
			read-only;
		};

		code_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "code-partition";
			reg = <0x10000 (DT_SIZE_M(2) - 0x10000)>;
			read-only;
		};
	};
};

&gpio0 {
	status = "okay";
};

&uart0 {
	current-speed = <115200>;
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&uart1 {
	current-speed = <115200>;
	status = "okay";
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

&i2c1 {
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	/* As the Pico SDK's I2C. */
	i2c-sda-hold-time-ns = <300>;
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_7b_default>;
	pinctrl-names = "default";
	/* 125 MHz / 153 / 4096 is about 200 Hz, as the stock firmware's. */
	divider-int-7 = <153>;
};

&adc {
	status = "okay";
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&timer {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&vreg {
	status = "okay";
};

&pio0 {
	status = "okay";
};

&pio1 {
	status = "okay";
};

/* No pinctrl: VBUS detect is forced, the badge's bus power is the RP2040's own. */
zephyr_udc0: &usbd {
	status = "okay";
};
