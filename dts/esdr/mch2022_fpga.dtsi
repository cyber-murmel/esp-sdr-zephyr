/*
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * The MCH2022 badge's iCE40 as an esp-sdr accelerator: an SPI device on spi3 (CS IO27, after
 * the LCD's IO32), CRESET and CDONE through the RP2040, interrupt on IO39.
 */

&spi3 {
	cs-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>, <&gpio0 27 GPIO_ACTIVE_LOW>;

	fpga: fpga@1 {
		compatible = "esdr,mch2022-fpga";
		reg = <1>;
		spi-max-frequency = <DT_FREQ_M(40)>;
		mfd = <&rp2040>;
		irq-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;		/* GPIO39 */
	};
};
